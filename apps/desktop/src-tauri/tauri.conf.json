{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scenecast",
  "version": "0.5.0-rc.1",
  "identifier": "com.github.jldeen.scenecast",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Scenecast",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: scenecast: http://scenecast.localhost; frame-src scenecast: http://scenecast.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "msi",
      "nsis"
    ],
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["scenecast"],
        "name": "Scenecast demo",
        "description": "Scenecast demo",
        "role": "Editor",
        "mimeType": "application/vnd.scenecast+zip",
        "exportedType": {
          "identifier": "com.github.jldeen.scenecast.demo",
          "conformsTo": ["public.zip-archive", "public.data"]
        }
      }
    ],
    "shortDescription": "Live demos, replicated: real pages, every run identical.",
    "longDescription": "Scenecast records a live web demo once and turns it into a high-fidelity, deterministic replica for presenting: real captured pages, real fonts, ZoomIt-style focus points.",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../packages/": "packages/",
      "../../../node_modules/playwright-core/": "node_modules/playwright-core/",
      "../../../node_modules/@github/copilot-sdk/": "node_modules/@github/copilot-sdk/",
      "../../../node_modules/koffi/": "node_modules/koffi/",
      "../../../node_modules/lossless-json/": "node_modules/lossless-json/",
      "../../../node_modules/vscode-jsonrpc/": "node_modules/vscode-jsonrpc/",
      "../../../node_modules/zod/": "node_modules/zod/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "hardenedRuntime": true
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "version": "0.5.0.1"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1RTE0QUUyMTU0NEFEMzYKUldRMnJVUVY0a3JoOWRMVzVkUGs4ckttV2FuQng2bTQxdkM5YytUdkl6SHJQK292aGpiN1dlZUMK",
      "endpoints": [
        "https://github.com/jldeen/scenecast/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
